Notebook[{
Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "Constants", "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"q", "=", "1"}], ";"}], " ", 
   RowBox[{"(*", "Charge", "*)"}], "\n", 
   RowBox[{
    RowBox[{"epsilon0", "=", 
     RowBox[{"8.854", "*", 
      RowBox[{"10", "^", 
       RowBox[{"-", "12"}]}]}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"Vacuum", " ", "permittivity"}], "*)"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Position", " ", "of", " ", "charge", " ", "on", " ", "the", " ", 
     "helix"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"RPrime", "[", "t_", "]"}], ":=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Cos", "[", "t", "]"}], ",", 
       RowBox[{"Sin", "[", "t", "]"}], ",", "t"}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"MagnitudeRPrime", "[", "t_", "]"}], ":=", 
     RowBox[{"Sqrt", "[", 
      RowBox[{"1", "+", 
       RowBox[{"t", "^", "2"}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Electric", " ", "field", " ", "components"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Ex", "[", "t_", "]"}], ":=", 
     RowBox[{
      RowBox[{"-", "q"}], "*", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Cos", "[", "t", "]"}], "/", 
        RowBox[{"(", 
         RowBox[{"4", " ", "Pi", " ", "epsilon0", "*", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "+", 
             RowBox[{"t", "^", "2"}]}], ")"}], "^", 
           RowBox[{"(", 
            RowBox[{"3", "/", "2"}], ")"}]}]}], ")"}]}], ")"}]}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Ey", "[", "t_", "]"}], ":=", 
     RowBox[{
      RowBox[{"-", "q"}], "*", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Sin", "[", "t", "]"}], "/", 
        RowBox[{"(", 
         RowBox[{"4", " ", "Pi", " ", "epsilon0", "*", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "+", 
             RowBox[{"t", "^", "2"}]}], ")"}], "^", 
           RowBox[{"(", 
            RowBox[{"3", "/", "2"}], ")"}]}]}], ")"}]}], ")"}]}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Ez", "[", "t_", "]"}], ":=", 
     RowBox[{
      RowBox[{"-", "q"}], "*", 
      RowBox[{"(", 
       RowBox[{"t", "/", 
        RowBox[{"(", 
         RowBox[{"4", " ", "Pi", " ", "epsilon0", "*", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "+", 
             RowBox[{"t", "^", "2"}]}], ")"}], "^", 
           RowBox[{"(", 
            RowBox[{"3", "/", "2"}], ")"}]}]}], ")"}]}], ")"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Numerical", " ", "integration", " ", "with", " ", "infinite", " ", 
     "limits"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"ExNum", "=", 
     RowBox[{"NIntegrate", "[", 
      RowBox[{
       RowBox[{"Ex", "[", "t", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", 
         RowBox[{"-", "Infinity"}], ",", "Infinity"}], "}"}]}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"EyNum", "=", 
     RowBox[{"NIntegrate", "[", 
      RowBox[{
       RowBox[{"Ey", "[", "t", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", 
         RowBox[{"-", "Infinity"}], ",", "Infinity"}], "}"}]}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"EzNum", "=", 
     RowBox[{"NIntegrate", "[", 
      RowBox[{
       RowBox[{"Ez", "[", "t", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", 
         RowBox[{"-", "Infinity"}], ",", "Infinity"}], "}"}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Plot", " ", "the", " ", "curve", " ", "for", " ", "t", " ", 
     RowBox[{"in", "[", 
      RowBox[{
       RowBox[{"-", "0"}], ",", 
       RowBox[{"2", "Pi"}]}], "]"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"ParametricPlot3D", "[", 
    RowBox[{
     RowBox[{"RPrime", "[", "t", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", 
       RowBox[{"2", "Pi"}]}], "}"}], ",", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<x\>\"", ",", "\"\<y\>\"", ",", "\"\<z\>\""}], "}"}]}], 
     ",", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"{", 
       RowBox[{"Thick", ",", "Red"}], "}"}]}], ",", 
     RowBox[{"Boxed", "->", "True"}], ",", 
     RowBox[{"LabelStyle", "->", 
      RowBox[{"{", 
       RowBox[{"FontSize", "->", "10"}], "}"}]}], ",", 
     RowBox[{"ViewPoint", "->", 
      RowBox[{"{", 
       RowBox[{"2", ",", 
        RowBox[{"-", "2"}], ",", "2"}], "}"}]}], ",", 
     RowBox[{"PlotRange", "->", "All"}], ",", 
     RowBox[{"MeshFunctions", "->", 
      RowBox[{"{", 
       RowBox[{"#3", "&"}], "}"}]}], ",", 
     RowBox[{"MeshStyle", "->", "Red"}], ",", 
     RowBox[{"Lighting", "->", "\"\<Neutral\>\""}], ",", 
     RowBox[{"PlotLabel", "->", "\"\<R'(t) = (cos(t), sin(t), t)\>\""}]}], 
    "]"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Output", " ", "the", " ", "results"}], "*)"}], "\n", 
   RowBox[{"{", 
    RowBox[{"ExNum", ",", "EyNum", ",", "EzNum"}], "}"}]}]}]], "Input",
