Notebook[{

Cell[CellGroupData[{
Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "Constants", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"q", "=", "1"}], ";"}], " ", 
   RowBox[{"(*", "Charge", "*)"}], "\n", 
   RowBox[{
    RowBox[{"epsilon0", "=", 
     RowBox[{"8.854", "*", 
      RowBox[{"10", "^", 
       RowBox[{"-", "12"}]}]}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"Vacuum", " ", "permittivity"}], "*)"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Position", " ", "of", " ", "charge", " ", "on", " ", "the", " ", 
     "helix"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"RPrime", "[", "t_", "]"}], ":=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Cos", "[", "t", "]"}], ",", 
       RowBox[{"Sin", "[", "t", "]"}], ",", "t"}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"MagnitudeRPrime", "[", "t_", "]"}], ":=", 
     RowBox[{"Sqrt", "[", 
      RowBox[{"1", "+", 
       RowBox[{"t", "^", "2"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Electric", " ", "field", " ", "components"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Ex", "[", "t_", "]"}], ":=", 
     RowBox[{
      RowBox[{"-", "q"}], "*", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Cos", "[", "t", "]"}], "/", 
        RowBox[{"(", 
         RowBox[{"4", " ", "Pi", " ", "epsilon0", "*", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "+", 
             RowBox[{"t", "^", "2"}]}], ")"}], "^", 
           RowBox[{"(", 
            RowBox[{"3", "/", "2"}], ")"}]}]}], ")"}]}], ")"}]}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Ey", "[", "t_", "]"}], ":=", 
     RowBox[{
      RowBox[{"-", "q"}], "*", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Sin", "[", "t", "]"}], "/", 
        RowBox[{"(", 
         RowBox[{"4", " ", "Pi", " ", "epsilon0", "*", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "+", 
             RowBox[{"t", "^", "2"}]}], ")"}], "^", 
           RowBox[{"(", 
            RowBox[{"3", "/", "2"}], ")"}]}]}], ")"}]}], ")"}]}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Ez", "[", "t_", "]"}], ":=", 
     RowBox[{
      RowBox[{"-", "q"}], "*", 
      RowBox[{"(", 
       RowBox[{"t", "/", 
        RowBox[{"(", 
         RowBox[{"4", " ", "Pi", " ", "epsilon0", "*", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "+", 
             RowBox[{"t", "^", "2"}]}], ")"}], "^", 
           RowBox[{"(", 
            RowBox[{"3", "/", "2"}], ")"}]}]}], ")"}]}], ")"}]}]}], ";"}], 
   "\n", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Numerical", " ", "integration", " ", "with", " ", "improved", " ", 
     "settings"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ExNum", "=", 
     RowBox[{"NIntegrate", "[", 
      RowBox[{
       RowBox[{"Ex", "[", "t", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", 
         RowBox[{"-", "10"}], ",", "10"}], "}"}], ",", 
       RowBox[{"Method", "->", "\"\<GlobalAdaptive\>\""}], ",", 
       RowBox[{"PrecisionGoal", "->", "4"}], ",", 
       RowBox[{"AccuracyGoal", "->", "4"}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"EyNum", "=", 
     RowBox[{"NIntegrate", "[", 
      RowBox[{
       RowBox[{"Ey", "[", "t", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", 
         RowBox[{"-", "10"}], ",", "10"}], "}"}], ",", 
       RowBox[{"Method", "->", "\"\<GlobalAdaptive\>\""}], ",", 
       RowBox[{"PrecisionGoal", "->", "4"}], ",", 
       RowBox[{"AccuracyGoal", "->", "4"}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"EzNum", "=", 
     RowBox[{"NIntegrate", "[", 
      RowBox[{
       RowBox[{"Ez", "[", "t", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", 
         RowBox[{"-", "10"}], ",", "10"}], "}"}], ",", 
       RowBox[{"Method", "->", "\"\<GlobalAdaptive\>\""}], ",", 
       RowBox[{"PrecisionGoal", "->", "4"}], ",", 
       RowBox[{"AccuracyGoal", "->", "4"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Plot", " ", "the", " ", "curve", " ", "for", " ", "t", " ", 
     RowBox[{"in", "[", 
      RowBox[{
       RowBox[{"-", "10"}], ",", "10"}], "]"}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"ParametricPlot3D", "[", 
    RowBox[{
     RowBox[{"RPrime", "[", "t", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", 
       RowBox[{"-", "10"}], ",", "10"}], "}"}], ",", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<x\>\"", ",", "\"\<y\>\"", ",", "\"\<z\>\""}], "}"}]}], 
     ",", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"{", 
       RowBox[{"Thick", ",", "Red"}], "}"}]}], ",", 
     RowBox[{"Boxed", "->", "True"}], ",", 
     RowBox[{"LabelStyle", "->", 
      RowBox[{"{", 
       RowBox[{"FontSize", "->", "10"}], "}"}]}], ",", 
     RowBox[{"ViewPoint", "->", 
      RowBox[{"{", 
       RowBox[{"10", ",", 
        RowBox[{"-", "10"}], ",", "10"}], "}"}]}], ",", 
     RowBox[{"PlotRange", "->", "All"}], ",", 
     RowBox[{"MeshFunctions", "->", 
      RowBox[{"{", 
       RowBox[{"#3", "&"}], "}"}]}], ",", 
     RowBox[{"MeshStyle", "->", "Red"}], ",", 
     RowBox[{"Lighting", "->", "\"\<Neutral\>\""}], ",", 
     RowBox[{"PlotLabel", "->", "\"\<R'(t) = (cos(t), sin(t), t)\>\""}]}], 
    "]"}], "\n", "\n", 
   RowBox[{"(*", 
    RowBox[{"Output", " ", "the", " ", "results"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"ExNum", ",", "EyNum", ",", "EzNum"}], "}"}]}]}]], "Input",
 CellChangeTimes->{3.948339475152956*^9},
 CellLabel->
  "In[341]:=",ExpressionUUID->"6d0ec0d8-20d9-5847-b44a-f88d015b0033"],

